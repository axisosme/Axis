{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/axisosme/Axis/schemas/runtime/run-start-envelope.schema.json",
  "title": "Axis Runtime Run Start Envelope 1.0.0",
  "type": "object",
  "properties": {
    "contractVersion": { "$ref": "common.schema.json#/$defs/contractVersion" }, "messageId": { "$ref": "common.schema.json#/$defs/providerNeutralId" }, "correlationId": { "$ref": "common.schema.json#/$defs/providerNeutralId" }, "operationId": { "$ref": "common.schema.json#/$defs/providerNeutralId" }, "causationMessageId": { "$ref": "common.schema.json#/$defs/providerNeutralId" }, "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "router" }, "consumer": { "const": "worker" }, "envelopeType": { "const": "run.start" }, "identity": { "$ref": "runtime-identity-graph.schema.json" }
  },
  "required": ["contractVersion", "messageId", "correlationId", "operationId", "causationMessageId", "occurredAt", "producer", "consumer", "envelopeType", "identity"], "additionalProperties": false
}
