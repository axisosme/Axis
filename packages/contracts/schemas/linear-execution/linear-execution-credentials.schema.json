{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/axisosme/Axis/schemas/linear-execution/linear-execution-credentials.schema.json",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "attemptId",
        "runId",
        "organizationId"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "organizationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "operation",
        "execution"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "operation": {
          "enum": [
            "issue",
            "revoke"
          ]
        },
        "execution": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "requestId",
            "status",
            "execution",
            "credentialId",
            "credential",
            "expiresAt"
          ],
          "properties": {
            "contractVersion": {
              "const": "1.0.0"
            },
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "status": {
              "const": "issued"
            },
            "execution": {
              "$ref": "#/$defs/identity"
            },
            "credentialId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "credential": {
              "type": "string",
              "pattern": "^axlea1_[A-Za-z0-9_-]{43}$"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "requestId",
            "status",
            "execution"
          ],
          "properties": {
            "contractVersion": {
              "const": "1.0.0"
            },
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "status": {
              "const": "revoked"
            },
            "execution": {
              "$ref": "#/$defs/identity"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "requestId",
            "status",
            "code"
          ],
          "properties": {
            "contractVersion": {
              "const": "1.0.0"
            },
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "status": {
              "const": "denied"
            },
            "code": {
              "enum": [
                "linear.execution.invalid_request",
                "linear.execution.invalid_credential",
                "linear.execution.expired",
                "linear.execution.revoked",
                "linear.execution.execution_denied",
                "linear.execution.installation_denied",
                "linear.execution.authorization_changed",
                "linear.execution.workspace_mismatch",
                "linear.execution.capacity",
                "linear.execution.unavailable"
              ]
            }
          }
        }
      ]
    }
  }
}
