{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/axisosme/Axis/schemas/agent-activity/agent-activity-response-receipt.schema.json",
  "title": "Axis Agent Activity Response Receipt 1.0.0",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "resultRef": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "displayText": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "linearConversationIdentity": {
      "type": "object",
      "properties": {
        "system": { "const": "linear" },
        "agentSessionId": { "$ref": "#/$defs/id" }
      },
      "required": ["system", "agentSessionId"],
      "additionalProperties": false
    },
    "conversationIdentity": { "$ref": "#/$defs/linearConversationIdentity" },
    "truncation": {
      "type": "object",
      "properties": {
        "fieldPath": { "enum": ["/content/body"] },
        "truncated": { "const": true },
        "originalScalarCount": { "type": "integer", "minimum": 4097, "maximum": 9007199254740991 },
        "omittedScalarCount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      },
      "required": ["fieldPath", "truncated", "originalScalarCount", "omittedScalarCount"],
      "additionalProperties": false
    },
    "receiptBase": {
      "type": "object",
      "properties": {
        "contractVersion": { "const": "1.0.0" },
        "activityId": { "$ref": "#/$defs/id" },
        "taskId": { "$ref": "#/$defs/id" },
        "attemptId": { "$ref": "#/$defs/id" },
        "runId": { "$ref": "#/$defs/id" },
        "conversation": { "$ref": "#/$defs/conversationIdentity" },
        "sourceEventId": { "$ref": "#/$defs/id" },
        "operationId": { "$ref": "#/$defs/id" },
        "truncated": { "type": "boolean" },
        "truncations": {
          "type": "array",
          "items": { "$ref": "#/$defs/truncation" },
          "maxItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "contractVersion",
        "activityId",
        "taskId",
        "attemptId",
        "runId",
        "conversation",
        "sourceEventId",
        "operationId",
        "truncated",
        "truncations"
      ]
    },
    "projectedResponse": {
      "type": "object",
      "properties": {
        "content": {
          "type": "object",
          "properties": {
            "type": { "const": "response" },
            "body": { "$ref": "#/$defs/displayText" }
          },
          "required": ["type", "body"],
          "additionalProperties": false
        },
        "projectionStatus": { "const": "projected" },
        "resultRef": { "$ref": "#/$defs/resultRef" }
      },
      "required": ["content", "projectionStatus", "resultRef"]
    },
    "fallbackResponse": {
      "type": "object",
      "properties": {
        "content": {
          "type": "object",
          "properties": {
            "type": { "const": "response" },
            "body": {
              "const": "The agent completed the turn, but no safe response could be projected."
            }
          },
          "required": ["type", "body"],
          "additionalProperties": false
        },
        "projectionStatus": { "const": "fallback" },
        "resultRef": { "$ref": "#/$defs/resultRef" }
      },
      "required": ["content", "projectionStatus", "resultRef"]
    },
    "responseReceipt": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/receiptBase" },
        {
          "oneOf": [
            { "$ref": "#/$defs/projectedResponse" },
            { "$ref": "#/$defs/fallbackResponse" }
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/responseReceipt"
}
